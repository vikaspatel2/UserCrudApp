@model List<Ticket>

@{
    ViewBag.Title = "All Tickets (Admin)";
}

<div class="container mt-4">
    <h3 class="mb-3">All Tickets (Admin)</h3>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Subject</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Created</th>
                        <th>Assigned To</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var t in Model)
                        {
                            <tr>
                                <td>@t.Id</td>
                                <td><strong>@t.Subject</strong></td>
                                <td>@t.Status</td>
                                <td>
                                    <span class="badge
                                        @(t.Priority == "High" ? "bg-danger" :
                                        t.Priority == "Normal" ? "bg-warning text-dark" :
                                        "bg-secondary")">
                                        @t.Priority
                                    </span>
                                </td>
                                <td>@t.createdt?.ToString("dd-MMM-yyyy")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(t.AssignedEmail))
                                    {
                                        @t.AssignedEmail
                                    }
                                    else
                                    {
                                        <span class="text-muted">Unassigned</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@t.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No tickets available.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


