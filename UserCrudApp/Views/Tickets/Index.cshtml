@model List<Ticket>

@{
    ViewBag.Title = "My Tickets";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3> My Tickets</h3>
        <a asp-action="Create" class="btn btn-primary">
            + New Ticket
        </a>
    </div>

    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["StatusMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Subject</th>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Created</th>
                        <th>Assigned To</th>
                        <th>SLA</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var t in Model)
                        {
                            <tr>
                                <td><strong>@t.Subject</strong></td>

                                <td>
                                    @* <span class="badge bg-secondary">
                                        @t.Status
                                    </span> *@
                                    <span class="badge
                                        @(t.Status == "Open" ? "bg-success" :
                                                      t.Status == "In Progress" ? "bg-warning text-dark" :
                                                      t.Status == "Closed" ? "bg-secondary" :
                                                      "bg-dark")">
                                        @t.Status
                                    </span>

                                </td>

                                <td>
                                    <span class="badge
                                                @(t.Priority == "High" ? "bg-danger" :
                                                    t.Priority == "Normal" ? "bg-warning text-dark" :
                                                    "bg-secondary")">
                                        @t.Priority
                                    </span>
                                </td>

                                <td>@t.createdt?.ToString("dd-MMM-yyyy")</td>

                                <td>
                                    @if (!string.IsNullOrEmpty(t.AssignedEmail))
                                    {
                                        @t.AssignedEmail
                                    }
                                    else
                                    {
                                        <span class="text-muted">Unassigned</span>
                                    }
                                </td>
                                <td>
                                    @if (t.DueDate < DateTime.Now && t.Status != "Closed")
                                    {
                                        <span class="badge bg-danger">Breached</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">On Track</span>
                                    }
                                </td>


                                <td class="text-end">
                                    <a asp-action="Details"
                                       asp-route-id="@t.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No tickets found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


